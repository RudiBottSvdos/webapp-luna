# Luna - Konfiguration. Kopieren nach ".env" und Werte anpassen. NIEMALS committen.

# --- Hermes (VM hermes) ---
# Adresse des Hermes-API-Servers (Port 8642), z. B. die IP der VM hermes
HERMES_URL=http://192.168.178.50:8642
# Muss dem API_SERVER_KEY in der Hermes-Konfiguration entsprechen
HERMES_API_KEY=
# Modellname, den der Hermes-API-Server erwartet
HERMES_MODEL=hermes-agent

# --- speaches (Spracherkennung + Sprachausgabe, läuft im Compose-Stack) ---
SPEACHES_URL=http://speaches:8000
# Whisper-Modell (CPU: small ist ein guter Start; Alternativen: -base, -medium)
STT_MODEL=Systran/faster-whisper-small
STT_LANGUAGE=de
# Piper-Modell für die Sprachausgabe
TTS_MODEL=speaches-ai/piper-de_DE-thorsten-medium
# Stimme innerhalb des Modells; Piper-Modelle haben meist nur eine Stimme.
# Falls speaches die Stimme ablehnt: verfügbare Stimmen via GET /v1/models prüfen.
TTS_VOICE=thorsten
# mp3 | wav | opus | flac | aac
TTS_FORMAT=mp3

# --- Sprachausgabe mit Pocket TTS (Kyutai) ---
# speaches = Piper-Stimmen oben; pocket = Pocket TTS (natürlicher, langsamer, liefert WAV)
TTS_ENGINE=speaches
POCKET_TTS_URL=http://pocket-tts:8000
# german (schneller) oder german_24l (beste Qualität)
POCKET_TTS_LANGUAGE=german_24l
# Eingebaute Stimme, z. B. vera, mary, eve, alba (Frauen) oder juergen (Mann)
POCKET_TTS_VOICE=vera

# --- Kopplung / Sicherheit ---
# PIN zum einmaligen Koppeln des Tablets (mind. 4 Zeichen, besser 6+)
PAIRING_PIN=
# Geheimnis zum Signieren der Cookies (mind. 32 Zeichen): openssl rand -hex 32
COOKIE_SECRET=

# --- Backend ---
PORT=3000
# Im Compose-Stack fest auf /data (Volume) gesetzt
DATA_DIR=./data

# --- Caddy / HTTPS (von docker-compose.yml gelesen) ---
# Domain, unter der die App erreichbar ist (A-Record auf die interne IP der VM web)
LUNA_DOMAIN=assistent.example.de
# Go-Modul des DNS-Plugins (Build-Argument), je nach DNS-Anbieter
CADDY_DNS_PLUGIN=github.com/caddy-dns/cloudflare
# Provider-Name im Caddyfile (cloudflare, hetzner, ionos, duckdns, ...)
CADDY_DNS_PROVIDER=cloudflare
# API-Token des DNS-Anbieters (nur Zonen-DNS-Bearbeitung freigeben)
CADDY_DNS_API_TOKEN=
